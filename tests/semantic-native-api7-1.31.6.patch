+static void
+ngx_stream_lua_ffi_socket_write_error_retval_handler(
+    ngx_stream_lua_request_t *r, ngx_stream_lua_socket_tcp_upstream_t *u,
+    u_char *errbuf, size_t *errbuf_size)
