-        return NGX_CONF_ERROR;
-    }
-
-    clcf = ngx_http_conf_get_module_loc_conf(cf, ngx_http_core_module);
-
-    if (clcf->noname
-        && conf->upstream.upstream == NULL && conf->proxy_lengths == NULL)
-    {
-        conf->upstream.upstream = prev->upstream.upstream;
