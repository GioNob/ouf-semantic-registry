-
-    plcf->redirect = 1;
-
-    value = cf->args->elts;
-
-    if (cf->args->nelts == 2) {
-        if (ngx_strcmp(value[1].data, "off") == 0) {
-
-            if (plcf->redirects) {
-                return "is duplicate";
-            }
-
-            plcf->redirect = 0;
-            return NGX_CONF_OK;
-        }
-
-        if (ngx_strcmp(value[1].data, "default") != 0) {
-            ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
-                               "invalid parameter \"%V\"", &value[1]);
