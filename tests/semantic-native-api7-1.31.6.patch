+
+    if (u->read_co_ctx) {
+        u->read_co_ctx->cleanup = NULL;
+    }
+
+    ft_type = u->ft_type;
+    u->ft_type = 0;
+
+    if (u->no_close) {
+        u->no_close = 0;
+
+    } else {
+        ngx_stream_lua_socket_tcp_finalize_read_part(r, u);
+    }
+
+    ngx_stream_lua_ffi_socket_prepare_error_retvals(r, u, ft_type,
+                                                    errbuf, errbuf_size);
+}
