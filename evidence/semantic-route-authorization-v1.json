{
  "version": "1.0",
  "authority": "PET Semantic 1.3 sections 65 and 160.7; deployed capability prefix ouf.semantic",
  "default": "DENY for registered routes without an explicit annotation",
  "routes": [
    {
      "controller": "ArtifactApi.java",
      "method": "POST",
      "path": "/artifacts",
      "capability": "ouf.semantic.propose"
    },
    {
      "controller": "ArtifactApi.java",
      "method": "GET",
      "path": "/artifacts/{id}",
      "capability": "ouf.semantic.read"
    },
    {
      "controller": "ArtifactApi.java",
      "method": "GET",
      "path": "/search",
      "capability": "ouf.semantic.search"
    },
    {
      "controller": "ArtifactApi.java",
      "method": "PATCH",
      "path": "/revisions/{id}",
      "capability": "ouf.semantic.propose"
    },
    {
      "controller": "ChangeGovernanceApi.java",
      "method": "POST",
      "path": "/change-notices",
      "capability": "ouf.semantic.propose"
    },
    {
      "controller": "ChangeGovernanceApi.java",
      "method": "GET",
      "path": "/change-notices/{id}",
      "capability": "ouf.semantic.read"
    },
    {
      "controller": "ChangeGovernanceApi.java",
      "method": "POST",
      "path": "/migration-proposals",
      "capability": "ouf.semantic.propose"
    },
    {
      "controller": "ChangeGovernanceApi.java",
      "method": "GET",
      "path": "/migration-proposals/{id}",
      "capability": "ouf.semantic.read"
    },
    {
      "controller": "DiscoveryApi.java",
      "method": "POST",
      "path": "",
      "capability": "ouf.semantic.discovery"
    },
    {
      "controller": "DiscoveryApi.java",
      "method": "GET",
      "path": "/{id}/candidates",
      "capability": "ouf.semantic.discovery"
    },
    {
      "controller": "DiscoveryApi.java",
      "method": "POST",
      "path": "/{requestId}/candidates/{candidateId}:adopt",
      "capability": "ouf.semantic.propose"
    },
    {
      "controller": "DiscoveryApi.java",
      "method": "GET",
      "path": "/providers",
      "capability": "ouf.semantic.discovery"
    },
    {
      "controller": "GovernanceApi.java",
      "method": "POST",
      "path": "/approval-challenges",
      "capability": "ouf.semantic.approval.request"
    },
    {
      "controller": "InterchangeApi.java",
      "method": "POST",
      "path": "/imports",
      "capability": "ouf.semantic.propose"
    },
    {
      "controller": "InterchangeApi.java",
      "method": "GET",
      "path": "/publication-sets/{setId}/artifacts/{artifactId}",
      "capability": "ouf.semantic.read"
    },
    {
      "controller": "ValidationApi.java",
      "method": "POST",
      "path": "/revisions/{id}:validate",
      "capability": "ouf.semantic.review.prepare"
    },
    {
      "controller": "ValidationApi.java",
      "method": "GET",
      "path": "/validation-runs/{id}",
      "capability": "ouf.semantic.read"
    },
    {
      "controller": "ValidationApi.java",
      "method": "POST",
      "path": "/impact-reports",
      "capability": "ouf.semantic.review.prepare"
    },
    {
      "controller": "ValidationApi.java",
      "method": "GET",
      "path": "/impact-reports/{id}",
      "capability": "ouf.semantic.read"
    },
    {
      "controller": "ValidationApi.java",
      "method": "GET",
      "path": "/references:resolve",
      "capability": "ouf.semantic.read"
    },
    {
      "controller": "ValidationApi.java",
      "method": "PUT",
      "path": "/consumer-references",
      "capability": "ouf.semantic.consumer-reference.write"
    }
  ]
}
