{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/semantic/semantic-reference-v1.json",
  "title": "OUF SemanticReference v1",
  "type": "object",
  "required": [
    "semanticId",
    "artifactId",
    "revisionId",
    "artifactType",
    "semanticVersion",
    "status",
    "canonicalUri",
    "namespace",
    "localName",
    "label",
    "publicationSetId"
  ],
  "properties": {
    "semanticId": {
      "type": "string",
      "minLength": 1
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "revisionId": {
      "type": "string",
      "minLength": 1
    },
    "artifactType": {
      "type": "string",
      "enum": [
        "ONTOLOGY",
        "DATATYPE",
        "VALUE_MAP",
        "CLASS",
        "PROPERTY",
        "RELATIONSHIP",
        "VOCABULARY",
        "CONCEPT",
        "RULE"
      ]
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Current lifecycle of the revision in the requested publication set.",
      "enum": [
        "ACTIVE",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "definition": {"type": "object"},
    "definitionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalUri": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "localName": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "publicationSetId": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {"properties": {"artifactType": {"const": "VALUE_MAP"}}},
  "then": {"properties": {"definition": {"$ref": "#/$defs/ValueMapDefinition"}}},
  "else": {"properties": {"definition": {"$ref": "#/$defs/DatatypeDefinition"}}},
  "$defs": {
    "ValueMapDefinition": {
      "type": "object",
      "required": ["targetVocabulary", "entries"],
      "additionalProperties": false,
      "properties": {
        "targetVocabulary": {
          "type": "string",
          "pattern": "^.+@[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "description": "Codes are unique by exact equality. Published entries are ordered as Java String.compareTo.",
          "items": {
            "type": "object",
            "required": ["code", "concept"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000](?:[^\\u0000-\\u001f\\u007f]*[^\\u0000-\\u001f\\u007f\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000])?(?![\\s\\S])"
              },
              "concept": {"type": "string", "minLength": 1}
            }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"it": {"type": "string"}, "en": {"type": "string"}}
        }
      }
    },
    "DatatypeDefinition": {
      "type": "object",
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["name", "type", "cardinality", "required"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$"},
              "type": {"type": "string", "description": "Base type id or published DATATYPE IRI@publicationSetId."},
              "cardinality": {"enum": ["ONE", "MANY"]},
              "required": {"type": "boolean"},
              "labels": {"type": "object", "additionalProperties": {"type": "string"}},
              "constraints": {
                "type": "object", "additionalProperties": false,
                "description": "Inclusive bounds are canonical strings for integer, decimal, date or datetime components. maxLength applies to string and vocabularyRef to concept.",
                "properties": {
                  "minInclusive": {"type": "string"},
                  "maxInclusive": {"type": "string"},
                  "maxLength": {"type": "integer", "minimum": 0},
                  "vocabularyRef": {"type": "string", "format": "iri", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:", "description": "Absolute IRI of a published VOCABULARY."}
                }
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {"properties": {"type": {"enum": ["integer", "decimal", "date", "datetime"]}}},
                "then": {"properties": {"constraints": {"propertyNames": {"enum": ["minInclusive", "maxInclusive"]}}}}
              },
              {
                "if": {"properties": {"type": {"const": "integer"}}},
                "then": {"properties": {"constraints": {"additionalProperties": {"pattern": "^(0|-?[1-9][0-9]*)$"}}}}
              },
              {
                "if": {"properties": {"type": {"const": "decimal"}}},
                "then": {"properties": {"constraints": {"additionalProperties": {"pattern": "^-?(0|[1-9][0-9]*)([.][0-9]*[1-9])?$", "not": {"const": "-0"}}}}}
              },
              {
                "if": {"properties": {"type": {"const": "date"}}},
                "then": {"properties": {"constraints": {"additionalProperties": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}}
              },
              {
                "if": {"properties": {"type": {"const": "datetime"}}},
                "then": {"properties": {"constraints": {"additionalProperties": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,9})?Z$"}}}}
              },
              {
                "if": {"properties": {"type": {"const": "string"}}},
                "then": {"properties": {"constraints": {"propertyNames": {"const": "maxLength"}}}}
              },
              {
                "if": {"properties": {"type": {"const": "concept"}}},
                "then": {"properties": {"constraints": {"propertyNames": {"const": "vocabularyRef"}}}}
              },
              {
                "if": {"properties": {"type": {"not": {"enum": ["integer", "decimal", "date", "datetime", "string", "concept"]}}}},
                "then": {"properties": {"constraints": {"maxProperties": 0}}}
              }
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Semantic Model / Registry v1.2"
  ],
  "x-ouf-scope-control": "Semantic Registry cross-module contracts only. No THS approval DTOs, Authorization policy DTOs, Onboarding source-specific mappings, UDP ABox edges, Query Governor state or MCP Server implementation changes.",
  "x-ouf-invariants": [
    "semanticId is semantic identity; artifactId/revisionId are technical/reproducibility identities",
    "historical reference resolves exact revision/publication context and never silently falls back to latest/ACTIVE"
  ]
}
