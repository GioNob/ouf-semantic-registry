  <groupId>it.comune.trieste.ouf</groupId><artifactId>semantic-registry</artifactId><version>1.0.0-SNAPSHOT</version>
  <name>OUF Semantic Model Registry</name>
  <properties><java.version>21</java.version><jena.version>5.5.0</jena.version><testcontainers.version>1.21.3</testcontainers.version></properties>
  <dependencies>
